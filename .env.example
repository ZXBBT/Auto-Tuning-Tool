# Copy to .env (never commit .env) and fill in. See deploy/DEPLOY.md.

# Path A: token of the tunnel created in the Cloudflare Zero Trust dashboard
TUNNEL_TOKEN=
# Uncomment to start the tunnel connector with plain `docker compose up -d`
# COMPOSE_PROFILES=tunnel

# Path B: the direct subdomain, e.g. direct.example.com
DOMAIN_DIRECT=
# Let's Encrypt account / expiry notices
ACME_EMAIL=
# Cloudflare API token with Zone.DNS:Edit on your zone (for the DDNS updater)
CF_API_TOKEN=

# Uncomment to make plain `docker compose` include the path B overlay
# COMPOSE_FILE=compose.yaml:compose.direct.yaml
